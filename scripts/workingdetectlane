#!/usr/bin/env python3
"""
detect_lane.py
--------------
ROS1 node: detects the YELLOW (left) and WHITE (right) lane lines using a
bird's-eye (perspective-warped) view, finds each lane's pixels with a
sliding-window search, fits a 2nd-order polynomial, smooths it over several
frames, and publishes the normalized lane center offset for control_lane.py.

Subscribes:
  ~image_topic (default /camera/image_raw)          sensor_msgs/Image

Publishes:
  /detect/lane_center       std_msgs/Float64   normalized offset in [-1, 1]
                                                (0 = centered, +1 = lane far right,
                                                 -1 = lane far left, NaN = no lane found)
  /detect/image_lane        sensor_msgs/Image  debug: warped view + masks + fitted curves
  /detect/image_warped      sensor_msgs/Image  debug: raw perspective-warp output
"""

import rospy
import cv2
import numpy as np
from collections import deque
from cv_bridge import CvBridge, CvBridgeError
from sensor_msgs.msg import Image
from std_msgs.msg import Float64


class AlphaBetaFilter:
    """Simple fixed-gain tracking filter for a single scalar (a lane's x
    position). Tracks position AND velocity, so during a brief dropout
    (e.g. a shadow hiding the line for a few frames) it keeps extrapolating
    in the direction the line was already moving, rather than freezing --
    much better than a plain "hold last value" during a curve.

    alpha: how much to trust a new measurement's POSITION (0-1, higher = snappier, noisier)
    beta:  how much to trust a new measurement's VELOCITY estimate (0-1, higher = adapts faster to curves)
    """
    def __init__(self, alpha=0.6, beta=0.3, max_coast_frames=10):
        self.alpha = alpha
        self.beta = beta
        self.max_coast_frames = max_coast_frames  # give up (return None) after this many consecutive misses
        self.x = None
        self.vx = 0.0
        self.coast_count = 0

    def reset(self, x0):
        self.x = x0
        self.vx = 0.0
        self.coast_count = 0

    def predict(self, dt):
        if self.x is None:
            return None
        return self.x + self.vx * dt

    def update(self, measurement, dt):
        """Call every frame. Pass `measurement=None` when this frame's
        detection failed (mask empty/rejected) -- the filter will coast on
        its velocity estimate instead. Returns the current best estimate,
        or None if we've coasted too long without a real measurement."""
        if self.x is None:
            if measurement is None:
                return None
            self.reset(measurement)
            return self.x

        x_pred = self.x + self.vx * dt

        if measurement is None:
            self.coast_count += 1
            if self.coast_count > self.max_coast_frames:
                self.x = None
                return None
            self.x = x_pred
            return self.x

        self.coast_count = 0
        residual = measurement - x_pred
        self.x = x_pred + self.alpha * residual
        if dt > 1e-6:
            self.vx = self.vx + (self.beta / dt) * residual
        return self.x


class DetectLane:
    def __init__(self):
        rospy.init_node("detect_lane", anonymous=False)

        # ---------------- Parameters ----------------
        self.image_topic = rospy.get_param("~image_topic", "/camera/image_raw")

        # Perspective-warp source points: corrected for a 320x240 camera image.
        self.warp_src = np.float32([
            rospy.get_param("~warp_src_tl", [80, 140]),
            rospy.get_param("~warp_src_tr", [240, 140]),
            rospy.get_param("~warp_src_br", [319, 239]),
            rospy.get_param("~warp_src_bl", [0, 239]),
        ])
        self.warp_w = rospy.get_param("~warp_width", 320)
        self.warp_h = rospy.get_param("~warp_height", 300)
        margin = rospy.get_param("~warp_dst_margin", 100)
        self.warp_dst = np.float32([
            [margin, 0],
            [self.warp_w - margin, 0],
            [self.warp_w - margin, self.warp_h],
            [margin, self.warp_h],
        ])
        self.M = cv2.getPerspectiveTransform(self.warp_src, self.warp_dst)

        # HSV thresholds -- TUNE for your Gazebo lighting/track texture
        self.yellow_lower = np.array(rospy.get_param("~yellow_lower", [15, 50, 50]))
        self.yellow_upper = np.array(rospy.get_param("~yellow_upper", [35, 255, 255]))
        self.white_lower  = np.array(rospy.get_param("~white_lower",  [0, 0, 180]))
        self.white_upper  = np.array(rospy.get_param("~white_upper",  [180, 60, 255]))

        clahe_clip_limit = rospy.get_param("~clahe_clip_limit", 2.0)
        clahe_tile_size = rospy.get_param("~clahe_tile_size", 8)
        self.clahe = cv2.createCLAHE(clipLimit=clahe_clip_limit, tileGridSize=(clahe_tile_size, clahe_tile_size))

        self.assumed_lane_width_px = rospy.get_param("~assumed_lane_width_px", 78)
        self.measured_lane_width = self.assumed_lane_width_px  # updated dynamically whenever both lanes are seen
        self.mov_avg_length = rospy.get_param("~mov_avg_length", 5)
        self.min_pixels = rospy.get_param("~min_lane_pixels", 50)
        self.max_pixels = rospy.get_param("~max_lane_pixels", 3000)  # reject masks this big as false-positive color bleed
        self.lookahead_frac = rospy.get_param("~lookahead_frac", 0.9)  # 0=far ahead(top of warp), 1=at the robot(bottom)

        # Direction-aware trust bias: on a known left turn, the outer (white)
        # line stays visible longer than the inner (yellow) line, which gets
        # swept off-frame faster since it's on the tighter radius. Bias the
        # center calculation toward whichever line is on the OUTSIDE of the
        # known turn, instead of averaging both lines equally.
        self.expected_turn_direction = rospy.get_param("~expected_turn_direction", "none")  # "none", "left", "right"
        self.turn_outer_bias = rospy.get_param("~turn_outer_bias", 0.75)  # 0.5=equal weight, 1.0=fully trust outer line

        # Sliding-window search params
        self.num_windows = rospy.get_param("~num_windows", 9)
        self.window_margin = rospy.get_param("~window_margin", 40)
        self.window_minpix = rospy.get_param("~window_minpix", 15)

        self.mov_avg_left = deque(maxlen=self.mov_avg_length)
        self.mov_avg_right = deque(maxlen=self.mov_avg_length)

        # Remember the last valid position of each lane line, so that if one
        # disappears we can tell whether it vanished off the SIDE of the
        # frame (a sharp curve -- keep steering that direction) versus just
        # becoming noisy in the middle of the image.
        self.last_left_x = None
        self.last_right_x = None
        self.edge_margin = rospy.get_param("~edge_margin", 25)  # px from the frame edge counted as "exited off-screen"
        self.turn_bias_frames = rospy.get_param("~turn_bias_frames", 30)  # how many frames to keep biasing after exit
        self.left_exit_countdown = 0
        self.right_exit_countdown = 0

        # Alpha-beta filters smooth brief dropouts (e.g. a shadow hiding the
        # line for a few frames) by extrapolating using recent velocity,
        # instead of freezing at the last known position.
        ab_alpha = rospy.get_param("~alpha_beta_alpha", 0.6)
        ab_beta  = rospy.get_param("~alpha_beta_beta", 0.3)
        ab_max_coast = rospy.get_param("~alpha_beta_max_coast_frames", 10)
        self.left_filter  = AlphaBetaFilter(ab_alpha, ab_beta, ab_max_coast)
        self.right_filter = AlphaBetaFilter(ab_alpha, ab_beta, ab_max_coast)
        self.last_frame_time = None

        # ROBOTIS-style reliability score (0-100) per lane: rises/falls based
        # on how continuously the color spans the image height, rather than
        # a hard binary detected/not-detected. Only lines with reliability
        # > 50 get trusted for steering -- smooths over brief shadow dropouts
        # far more gracefully than an instant NaN.
        self.reliability_yellow = 100
        self.reliability_white = 100
        self.reliability_step = rospy.get_param("~reliability_step", 5)
        self.reliability_threshold = rospy.get_param("~reliability_threshold", 50)

        # ROBOTIS-style auto-adjusting lightness (V channel) floor: self-tunes
        # every frame based on how many pixels got detected, automatically
        # loosening in shadow and tightening when swamped with noise, instead
        # of a single fixed brightness threshold.
        self.auto_adjust_lightness = rospy.get_param("~auto_adjust_lightness", True)
        self.lightness_step = rospy.get_param("~lightness_step", 5)
        self.yellow_v_floor_min = rospy.get_param("~yellow_v_floor_min", 20)
        self.yellow_v_floor_max = rospy.get_param("~yellow_v_floor_max", 250)
        self.white_v_floor_min = rospy.get_param("~white_v_floor_min", 100)
        self.white_v_floor_max = rospy.get_param("~white_v_floor_max", 250)
        self.mask_pixels_high = rospy.get_param("~mask_pixels_high", 8000)  # too much -> raise floor
        self.mask_pixels_low = rospy.get_param("~mask_pixels_low", 400)    # too little -> lower floor

        # ---------------- ROS plumbing ----------------
        self.bridge = CvBridge()
        self.center_pub = rospy.Publisher("/detect/lane_center", Float64, queue_size=1)
        self.debug_pub  = rospy.Publisher("/detect/image_lane", Image, queue_size=1)
        self.warp_pub   = rospy.Publisher("/detect/image_warped", Image, queue_size=1)
        self.image_sub  = rospy.Subscriber(self.image_topic, Image, self.image_callback,
                                            queue_size=1, buff_size=2**24)

        rospy.loginfo("detect_lane node started, listening on %s", self.image_topic)

    # ------------------------------------------------------------------
    def warp(self, frame):
        return cv2.warpPerspective(frame, self.M, (self.warp_w, self.warp_h))

    def find_base_x(self, mask, side):
        """Histogram-based starting x-position for the bottom sliding window,
        restricted to the left/right half of the image for that lane's side."""
        histogram = np.sum(mask[int(self.warp_h * 2 / 3):, :], axis=0)
        half = self.warp_w // 2
        if side == "left":
            region = histogram[:half]
            if region.max() > 0:
                return int(np.argmax(region))
            return self.warp_w // 4
        else:
            region = histogram[half:]
            if region.max() > 0:
                return half + int(np.argmax(region))
            return int(self.warp_w * 3 / 4)

    def sliding_window_fit(self, mask, mov_avg_buffer, side):
        """Sliding-window lane search: walk up the image in `num_windows` bands,
        only keeping pixels within `window_margin` of the current center, and
        recentering that center on the mean x of pixels found in each band.
        This ignores stray blobs (e.g. a guardrail) that aren't continuous
        with the actual lane line. Base x is recomputed fresh from the
        histogram every frame (no cross-frame carry-over, to avoid drift)."""
        nonzero_y, nonzero_x = mask.nonzero()
        if len(nonzero_x) < self.min_pixels or len(nonzero_x) > self.max_pixels:
            return np.mean(np.array(mov_avg_buffer), axis=0) if len(mov_avg_buffer) > 0 else None

        x_current = self.find_base_x(mask, side)
        window_height = self.warp_h // self.num_windows

        lane_inds = []
        for window in range(self.num_windows):
            y_low = self.warp_h - (window + 1) * window_height
            y_high = self.warp_h - window * window_height
            x_low = x_current - self.window_margin
            x_high = x_current + self.window_margin

            good = ((nonzero_y >= y_low) & (nonzero_y < y_high) &
                    (nonzero_x >= x_low) & (nonzero_x < x_high)).nonzero()[0]
            lane_inds.append(good)
            if len(good) > self.window_minpix:
                x_current = int(np.mean(nonzero_x[good]))

        lane_inds = np.concatenate(lane_inds) if len(lane_inds) else np.array([], dtype=int)
        if len(lane_inds) < self.min_pixels:
            return np.mean(np.array(mov_avg_buffer), axis=0) if len(mov_avg_buffer) > 0 else None

        lane_x = nonzero_x[lane_inds]
        lane_y = nonzero_y[lane_inds]
        coeffs = np.polyfit(lane_y, lane_x, 2)
        mov_avg_buffer.append(coeffs)
        return np.mean(np.array(mov_avg_buffer), axis=0)

    @staticmethod
    def x_at_row(coeffs, y):
        a, b, c = coeffs
        return a * y**2 + b * y + c

    def update_reliability(self, mask, current_reliability):
        """ROBOTIS-style: count how many rows have zero detected pixels; if
        too many rows are empty, the line's coverage is patchy (shadow,
        occlusion) so reliability drops. If coverage is consistently good,
        reliability climbs back up. Smooths over brief per-frame dropouts
        much better than a hard binary detected/not."""
        rows_with_pixels = np.count_nonzero(mask.any(axis=1))
        rows_missing = mask.shape[0] - rows_with_pixels
        row_coverage_threshold = rospy.get_param("~row_coverage_threshold", 0.7)  # fraction of rows allowed to be empty before reliability drops
        if rows_missing > mask.shape[0] * row_coverage_threshold:
            return max(0, current_reliability - self.reliability_step)
        else:
            return min(100, current_reliability + self.reliability_step)

    def auto_adjust_v_floor(self, lower_arr, pixel_count, v_min, v_max):
        """ROBOTIS-style self-tuning brightness floor: raise it if swamped
        with noise, lower it if barely detecting anything (e.g. shadow) --
        adapts every frame instead of relying on one fixed threshold."""
        v_floor = lower_arr[2]
        if pixel_count > self.mask_pixels_high and v_floor < v_max:
            v_floor = min(v_max, v_floor + self.lightness_step)
        elif pixel_count < self.mask_pixels_low and v_floor > v_min:
            v_floor = max(v_min, v_floor - self.lightness_step)
        lower_arr[2] = v_floor
        return lower_arr

    # ------------------------------------------------------------------
    def image_callback(self, msg):
        try:
            frame = self.bridge.imgmsg_to_cv2(msg, desired_encoding="bgr8")
        except CvBridgeError as e:
            rospy.logerr("cv_bridge error: %s", e)
            return

        warped = self.warp(frame)
        hsv = cv2.cvtColor(warped, cv2.COLOR_BGR2HSV)

        # Locally re-normalize brightness (CLAHE) before thresholding, so a
        # shadowed patch of yellow/white paint reads similarly to a sunlit
        # patch -- a single global brightness threshold can't handle both.
        h_ch, s_ch, v_ch = cv2.split(hsv)
        v_eq = self.clahe.apply(v_ch)
        hsv = cv2.merge([h_ch, s_ch, v_eq])

        yellow_mask = cv2.inRange(hsv, self.yellow_lower, self.yellow_upper)
        white_mask  = cv2.inRange(hsv, self.white_lower,  self.white_upper)
        # Never let a pixel that qualifies as yellow also count as white --
        # avoids the two masks fighting over the same washed-out pixels.
        white_mask = cv2.bitwise_and(white_mask, cv2.bitwise_not(yellow_mask))

        kernel = np.ones((5, 5), np.uint8)
        yellow_mask = cv2.morphologyEx(yellow_mask, cv2.MORPH_OPEN, kernel)
        white_mask  = cv2.morphologyEx(white_mask,  cv2.MORPH_OPEN, kernel)

        yellow_pixel_count = np.count_nonzero(yellow_mask)
        white_pixel_count = np.count_nonzero(white_mask)

        if self.auto_adjust_lightness:
            self.yellow_lower = self.auto_adjust_v_floor(
                self.yellow_lower, yellow_pixel_count, self.yellow_v_floor_min, self.yellow_v_floor_max)
            self.white_lower = self.auto_adjust_v_floor(
                self.white_lower, white_pixel_count, self.white_v_floor_min, self.white_v_floor_max)

        self.reliability_yellow = self.update_reliability(yellow_mask, self.reliability_yellow)
        self.reliability_white = self.update_reliability(white_mask, self.reliability_white)

        left_fit  = self.sliding_window_fit(yellow_mask, self.mov_avg_left, "left")
        right_fit = self.sliding_window_fit(white_mask,  self.mov_avg_right, "right")

        lookahead_y = int(self.warp_h * self.lookahead_frac)

        left_x_raw  = self.x_at_row(left_fit,  lookahead_y) if left_fit  is not None else None
        right_x_raw = self.x_at_row(right_fit, lookahead_y) if right_fit is not None else None

        # Don't trust a lane's raw detection if its reliability score has
        # dropped too low (patchy coverage, e.g. mid-shadow) -- treat it the
        # same as "not detected this frame" so the alpha-beta filter coasts.
        if self.reliability_yellow <= self.reliability_threshold:
            left_x_raw = None
        if self.reliability_white <= self.reliability_threshold:
            right_x_raw = None

        # Smooth through brief dropouts (e.g. a shadow) with the alpha-beta
        # filters, rather than trusting the raw fit-or-nothing result directly.
        now = rospy.Time.now().to_sec()
        dt = (now - self.last_frame_time) if self.last_frame_time is not None else (1.0 / 20.0)
        dt = max(dt, 1e-3)
        self.last_frame_time = now

        left_x  = self.left_filter.update(left_x_raw,  dt)
        right_x = self.right_filter.update(right_x_raw, dt)

        # Update edge-exit memory: did a lane that WAS visible just vanish
        # while it was last seen right at the frame's edge? That means a
        # sharp curve is happening in that direction, not a random dropout.
        if left_x is None and self.last_left_x is not None and self.last_left_x <= self.edge_margin:
            self.left_exit_countdown = self.turn_bias_frames
        if right_x is None and self.last_right_x is not None and self.last_right_x >= (self.warp_w - self.edge_margin):
            self.right_exit_countdown = self.turn_bias_frames

        if left_x is not None:
            self.last_left_x = left_x
            self.left_exit_countdown = 0  # reacquired -- cancel any pending turn bias
        if right_x is not None:
            self.last_right_x = right_x
            self.right_exit_countdown = 0

        if left_x is not None and right_x is not None:
            self.measured_lane_width = 0.8 * self.measured_lane_width + 0.2 * abs(right_x - left_x)

            center_from_left  = left_x + self.measured_lane_width / 2.0   # yellow-anchored estimate
            center_from_right = right_x - self.measured_lane_width / 2.0  # white-anchored estimate

            if self.expected_turn_direction == "left":
                # White is the outer line on a left turn -- trust it more.
                center_x = (1.0 - self.turn_outer_bias) * center_from_left + self.turn_outer_bias * center_from_right
            elif self.expected_turn_direction == "right":
                # Yellow is the outer line on a right turn -- trust it more.
                center_x = self.turn_outer_bias * center_from_left + (1.0 - self.turn_outer_bias) * center_from_right
            else:
                center_x = (left_x + right_x) / 2.0

        elif left_x is not None:  # white/right missing
            if self.right_exit_countdown > 0:
                # White line exited off the RIGHT edge -> sharp right turn in
                # progress. Keep steering hard right instead of centering off
                # the yellow line alone (which would straighten the robot out
                # mid-curve and drive it off the track).
                center_x = float(self.warp_w)
                self.right_exit_countdown -= 1
            else:
                center_x = left_x + self.measured_lane_width / 2.0

        elif right_x is not None:  # yellow/left missing
            if self.left_exit_countdown > 0:
                # Yellow line exited off the LEFT edge -> sharp left turn.
                center_x = 0.0
                self.left_exit_countdown -= 1
            else:
                center_x = right_x - self.measured_lane_width / 2.0

        else:  # both missing
            if self.left_exit_countdown > 0:
                center_x = 0.0
                self.left_exit_countdown -= 1
            elif self.right_exit_countdown > 0:
                center_x = float(self.warp_w)
                self.right_exit_countdown -= 1
            else:
                rospy.logwarn_throttle(2.0, "detect_lane: no lane pixels found")
                self.center_pub.publish(Float64(float("nan")))
                self.publish_debug(warped, yellow_mask, white_mask, None, None, None, lookahead_y)
                return

        image_center_x = self.warp_w / 2.0
        normalized_offset = (center_x - image_center_x) / image_center_x
        normalized_offset = max(-1.5, min(1.5, normalized_offset))

        self.center_pub.publish(Float64(normalized_offset))
        self.publish_debug(warped, yellow_mask, white_mask, left_x, right_x, center_x, lookahead_y)

    # ------------------------------------------------------------------
    def publish_debug(self, warped, yellow_mask, white_mask, left_x, right_x, center_x, y_draw):
        if self.debug_pub.get_num_connections() == 0 and self.warp_pub.get_num_connections() == 0:
            return

        try:
            self.warp_pub.publish(self.bridge.cv2_to_imgmsg(warped, encoding="bgr8"))
        except CvBridgeError as e:
            rospy.logerr("cv_bridge error (warp publish): %s", e)

        debug_img = warped.copy()
        debug_img[yellow_mask > 0] = [0, 255, 255]
        debug_img[white_mask > 0]  = [255, 255, 255]

        if left_x is not None:
            cv2.circle(debug_img, (int(left_x), y_draw), 6, (0, 165, 255), -1)
        if right_x is not None:
            cv2.circle(debug_img, (int(right_x), y_draw), 6, (128, 128, 128), -1)
        if center_x is not None:
            cv2.circle(debug_img, (int(center_x), y_draw), 6, (0, 0, 255), -1)
            cv2.line(debug_img, (int(center_x), 0), (int(center_x), self.warp_h), (0, 0, 255), 1)

        try:
            self.debug_pub.publish(self.bridge.cv2_to_imgmsg(debug_img, encoding="bgr8"))
        except CvBridgeError as e:
            rospy.logerr("cv_bridge error (debug publish): %s", e)


if __name__ == "__main__":
    node = DetectLane()
    rospy.spin()